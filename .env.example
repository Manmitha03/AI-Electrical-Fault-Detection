# ═══════════════════════════════════════════════════════════
# AI Electric Fault Detection — Environment Configuration
# ═══════════════════════════════════════════════════════════

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/fault_detection.db

# LLM Integration (optional — system works without it)
# Set LLM_PROVIDER to 'openai' or 'anthropic' and provide API key
LLM_PROVIDER=none
LLM_API_KEY=

# MQTT IoT Integration (optional)
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=electrical/sensors

# IoT Simulator Settings
IOT_INTERVAL_SECONDS=2

# Demo Mode (enables demo scenario endpoints)
DEMO_MODE=true

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
